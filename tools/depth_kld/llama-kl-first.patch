+// LLAMA_KL_FIRST=N (Halocline): score positions N .. n_ctx-2 of each chunk instead of n_ctx/2 .. n_ctx-2, so the scored
+// window can sit after a long prefix. A base written that way starts with "_logitsF" and stores N after n_chunk; a
+// base without it is the stock "_logits_" file, unchanged.
+static int kl_first_env(int n_ctx) {
+    const char * v = getenv("LLAMA_KL_FIRST");
+    if (v == nullptr || *v == 0) {
+        return n_ctx/2;
+    }
+    const int first = atoi(v);
+    if (first < 1 || first > n_ctx - 2) {
+        LOG_ERR("LLAMA_KL_FIRST=%s is outside 1 .. n_ctx-2 (n_ctx %d)\n", v, n_ctx);
+        exit(1);
+    }
+    return first;
+}
